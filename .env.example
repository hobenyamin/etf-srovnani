# Vzor proměnných prostředí. Zkopírujte do .env.local a doplňte hodnoty (.env.local se necommituje).
# Stejné proměnné nastavte na Vercelu: Project → Settings → Environment Variables.

# --- Supabase (krok 4a) – jen server, nikdy NEXT_PUBLIC_ ---
# Supabase → Project Settings → Data API → Project URL (https://<ref>.supabase.co)
SUPABASE_URL=
# Supabase → Project Settings → API Keys → Secret keys (sb_secret_…). Obchází RLS, nikdy do prohlížeče.
SUPABASE_SECRET_KEY=

# --- Podpis odkazů (krok 4a/4b) ---
# Náhodný řetězec, např. výstup `openssl rand -base64 32`. Podepisuje ID leadu a odkazy na odhlášení.
LEAD_TOKEN_SECRET=

# --- Resend (krok 4b) ---
# Resend → API Keys → Create API Key (Sending access, doména mail.hosek.cc)
RESEND_API_KEY=
# Odesílatel na ověřené doméně, např. Srovnání ETF <srovnani@mail.hosek.cc>
EMAIL_FROM=
# Základ odkazů v e-mailech bez lomítka na konci: http://localhost:3000 lokálně, produkční URL na Vercelu
SITE_URL=

# --- PostHog (krok 4c) – veřejné, vkládají se do kódu při buildu ---
# PostHog → Project settings → Project API key (phc_…)
NEXT_PUBLIC_POSTHOG_KEY=
# EU Cloud. Prohlížeč posílá eventy na /ingest na vlastní doméně, server je přeposílá sem (next.config.ts).
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
